generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum MessageStatus {
  NEW
  READ
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id          String   @id @default(cuid())
  siteName    String
  description String
  logoUrl     String?
  faviconUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HeroContent {
  id          String   @id @default(cuid())
  title       String
  subtitle    String
  description String?
  ctaText     String?
  ctaUrl      String?
  updatedAt   DateTime @updatedAt
}

model AboutContent {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String?
  updatedAt   DateTime @updatedAt
}

model BotContent {
  id          String   @id @default(cuid())
  name        String
  description String
  version     String?
  imageUrl    String?
  features    Json?
  commands    Json?
  externalUrl String
  published   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDescription String
  fullDescription String
  icon            String?
  imageUrl        String?
  published       Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, displayOrder])
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  imageUrl     String?
  url          String?
  category     String?
  technologies Json?
  published    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, displayOrder])
}

model Promotion {
  id           String   @id @default(cuid())
  title        String
  description  String
  imageUrl     String?
  ctaText      String?
  ctaUrl       String?
  published    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialLink {
  id           String   @id @default(cuid())
  name         String   @unique
  url          String
  icon         String?
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  whatsapp  String
  service   String
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model SeoSettings {
  id          String   @id @default(cuid())
  title       String
  description String
  keywords    String?
  canonical   String?
  ogImageUrl  String?
  updatedAt   DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  name      String
  url       String
  mimeType  String
  size      Int?
  alt       String?
  createdAt DateTime @default(now())
}
