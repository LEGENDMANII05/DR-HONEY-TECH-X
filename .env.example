# Hosted PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Required: random 32+ character secret. Generate a new value for production.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Bootstrap admin credentials. Put the real values in Vercel Environment Variables,
# not in source control.
ADMIN_USERNAME="DRHONEY05"
ADMIN_PASSWORD="SET_YOUR_ADMIN_PASSWORD_HERE"

# Set true temporarily/continuously if you want the env credentials to be able
# to recover/synchronize the bootstrap admin password.
ADMIN_FORCE_SYNC="true"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""
